# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (the frontend)
CORS_ORIGINS=http://localhost:5173

# LLM provider: "gemini" (real) or "mock" (offline demo / tests, no key needed)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# Per-attempt timeout for the LLM call, and retries for transient failures (429 / 5xx / timeout)
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# Input limits
MAX_CODE_CHARS=20000

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
